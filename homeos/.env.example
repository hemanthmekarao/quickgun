# ---- HomeOS configuration -------------------------------------------------
# Copy to .env (docker compose reads it) or export these for the API process.

# Database
DATABASE_URL=postgresql://homeos:homeos@localhost:5432/homeos

# Secrets — REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"   (JWT_SECRET)
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   (DATA_ENCRYPTION_KEY, exactly 64 hex chars)
# Losing DATA_ENCRYPTION_KEY makes every stored document unreadable. Back it up separately from the database.
JWT_SECRET=
DATA_ENCRYPTION_KEY=

# URLs
PORT=4000
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000
WEB_ORIGINS=http://localhost:3000
# Used by the web app's server to reach the API (same-origin /api proxy)
API_URL=http://localhost:4000
# COOKIE_SECURE=true            # defaults to true in production

# Document storage: local disk (default) or any S3-compatible bucket
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=                  # for MinIO / R2
# S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=25

# Optional: Redis for durable background jobs (otherwise jobs run in-process)
# REDIS_URL=redis://localhost:6379

# Optional: AI model for the assistant and for reading text from photos/scans
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: e-mail reminders
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM=HomeOS <no-reply@example.com>

# Optional: inbound e-mail webhook (forward invoices by e-mail)
# INBOUND_EMAIL_SECRET=

# Demo only (ignored in production): simulated payment provider
# PAYMENTS_SANDBOX=true

# Scheduler and limits
# SCHEDULER_ENABLED=true        # daily reminder scan; run on exactly one API instance
# DELETION_JOB_ENABLED=false    # erase data for deletion requests after the 30-day grace period
# RATE_LIMIT_PER_MINUTE=300
